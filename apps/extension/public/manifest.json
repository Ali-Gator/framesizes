{
  "manifest_version": 3,
  "name": "Gallery Wall Layout Generator",
  "description": "Visual gallery wall layout generator and photo collage planner: try frame sizes on wall, arrange pictures, get nail marks.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Gallery Wall Layout Generator",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "contextMenus", "activeTab", "scripting"],
  "externally_connectable": { "matches": ["https://framesizes.app/*"] }
}
